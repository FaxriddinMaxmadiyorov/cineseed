<section class="ledger" aria-label="<%= t("table.caption", page: page) %>">
  <table class="ledger__table">
    <thead>
      <tr>
        <th scope="col" class="ledger__index"><%= t("table.index") %></th>
        <th scope="col" class="ledger__title"><%= t("table.title") %></th>
        <th scope="col" class="ledger__actors"><%= t("table.actors") %></th>
        <th scope="col" class="ledger__year"><%= t("table.year") %></th>
        <th scope="col" class="ledger__genre"><%= t("table.genre") %></th>
        <th scope="col" class="ledger__toggle"><span class="visually-hidden"><%= t("table.details") %></span></th>
      </tr>
    </thead>
    <% movies.each do |movie| %>
      <tbody class="entry" lang="<%= movie.region.code %>" data-controller="entry"
             data-entry-warm-url-value="<%= warm_url_for(movie) %>">
        <tr class="entry__row" data-action="click->entry#toggle">
          <td class="ledger__index"><%= movie.index %></td>
          <td class="ledger__title">
            <button type="button" class="entry__title" aria-expanded="false" aria-controls="details-<%= movie.index %>"
                    data-entry-target="button" data-action="entry#toggle:stop"><%= movie.title %></button>
            <% if movie.series? %><span class="entry__kind"><%= kind_label(movie) %></span><% end %>
            <span class="entry__inline">
              <span class="entry__inline-meta"><span><%= year_label(movie) %></span> <span class="genre"><span class="genre__swatch" style="--swatch: <%= genre_color(movie) %>"></span><%= movie.genre_name %></span></span>
              <span class="entry__inline-actors"><%= actors_label(movie) %></span>
            </span>
          </td>
          <td class="ledger__actors"><%= actors_label(movie) %></td>
          <td class="ledger__year"><%= year_label(movie) %></td>
          <td class="ledger__genre"><span class="genre"><span class="genre__swatch" style="--swatch: <%= genre_color(movie) %>"></span><%= movie.genre_name %></span></td>
          <td class="ledger__toggle" aria-hidden="true">
            <svg class="chevron" viewBox="0 0 16 16" width="16" height="16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </td>
        </tr>
        <tr class="entry__details" id="details-<%= movie.index %>" hidden data-entry-target="details">
          <td colspan="6"><%= render "catalog/details", movie: movie %></td>
        </tr>
      </tbody>
    <% end %>
  </table>

  <nav class="pager" aria-label="<%= t("pager.label") %>">
    <div class="pager__steps">
      <% if page > 1 %>
        <%= link_to t("pager.previous"), root_path(catalog_query(page: page - 1)), class: "pager__link", rel: "prev" %>
      <% else %>
        <span class="pager__link is-disabled" aria-disabled="true"><%= t("pager.previous") %></span>
      <% end %>
      <span class="pager__current" aria-current="page"><%= t("pager.page", page: page) %></span>
      <%= link_to t("pager.next"), root_path(catalog_query(page: page + 1)), class: "pager__link", rel: "next" %>
    </div>
    <%= link_to export_path(catalog_query(page: page).except(:view)), class: "export", data: { turbo: false },
          title: t("pager.export_hint") do %>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M10 3v9m0 0l-3.5-3.5M10 12l3.5-3.5M4 14.5V16h12v-1.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= t("pager.export") %>
    <% end %>
  </nav>
</section>
