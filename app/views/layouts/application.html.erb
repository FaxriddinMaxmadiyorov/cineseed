<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="<%= t("app.description") %>">
    <%# no snapshot cache: cloning the page would make the browser fetch every lazy freeze frame %>
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= preload_link_tag asset_path("FiraSans-Regular.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag asset_path("FiraSansExtraCondensed-SemiBold.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
